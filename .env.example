# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=AutoPilot
MONGODB_DB=social_media_automation

# --- Redis / BullMQ job queue ---
REDIS_URL=redis://localhost:6379

# --- Local server ---
PORT=3000
HOSTNAME=0.0.0.0

# --- NextAuth (app login) ---
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Google OAuth (NextAuth login provider) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub OAuth (connect account + webhook) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- LinkedIn OAuth (connect account + publishing) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Instagram OAuth + webhook (via Meta Developer app) ---
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# Arbitrary string you choose; must match the value configured in the Meta webhook subscription.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Fallback access token used when looking up a sender's profile.
INSTAGRAM_REPLIED_ACCESSTOKEN=

# --- WhatsApp webhook verification (via Meta Developer app) ---
# No connect flow or message processing exists yet — this only lets the
# webhook pass Meta's verification handshake during WABA onboarding.
# Arbitrary string you choose; must match the value configured in the Meta webhook subscription.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- AI drafting (post generation + auto-reply), NVIDIA NIM OpenAI-compatible endpoint ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_TEMPERATURE=0.7
NVIDIA_TOP_P=0.95
NVIDIA_MAX_TOKENS=4096
NVIDIA_REASONING_BUDGET=4096

# --- Tech news feed (newsdata.io) ---
NEWS_API_KEY=

# --- Optional: bearer/query auth for /api/cron when triggered externally ---
CRON_SECRET=
