# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=AutoPilot
MONGODB_DB=social_media_automation

# --- Redis / BullMQ job queue ---
REDIS_URL=redis://localhost:6379

# --- Local server ---
PORT=3000
HOSTNAME=0.0.0.0

# --- NextAuth (app login) ---
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Google OAuth (NextAuth login provider) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub OAuth (connect account + webhook) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- LinkedIn OAuth (connect account + publishing) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Instagram OAuth + webhook (Instagram API with Instagram Login — native flow) ---
# These are the Instagram App ID/Secret from the Meta dashboard's "Instagram" product,
# NOT the main Meta App ID/Secret and NOT the old Facebook Login for Business credentials.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Arbitrary string you choose; must match the value configured in the Meta webhook subscription.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Fallback access token used when looking up a sender's profile.
INSTAGRAM_REPLIED_ACCESSTOKEN=

# --- Cloudinary (mirrors Meta's short-lived Instagram profile picture URLs
# so avatars in the dashboard/drafts inbox don't rot — see lib/cloudinary.js) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- WhatsApp webhook verification (via Meta Developer app) ---
# No connect flow or message processing exists yet — this only lets the
# webhook pass Meta's verification handshake during WABA onboarding.
# Arbitrary string you choose; must match the value configured in the Meta webhook subscription.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- AI drafting (post generation + auto-reply), NVIDIA NIM OpenAI-compatible endpoint ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_TEMPERATURE=0.7
NVIDIA_TOP_P=0.95
NVIDIA_MAX_TOKENS=4096
NVIDIA_REASONING_BUDGET=4096

# --- Freemius billing (@freemius/sdk client — see lib/freemius.js) ---
# All four values come from the Freemius dashboard (Products page).
FREEMIUS_PRODUCT_ID=
# Bearer credential used for authenticated API calls (e.g. purchase.retrievePurchase).
FREEMIUS_API_KEY=
# HMAC signing key — the SDK uses this to verify the X-Signature header on
# incoming webhook POSTs, and to sign checkout requests. Not the same as a
# license's sk_... secret_key or a user's pk_... public_key.
FREEMIUS_SECRET_KEY=
# RSA public key, used by the SDK for checkout link/redirect verification.
FREEMIUS_PUBLIC_KEY=
# Used only by scripts/seed-billing-plans.js to populate the billing_plans
# collection's provider_plan_id — not read directly by the app at runtime.
FREEMIUS_PRO_PLAN_ID=
FREEMIUS_UNLIMITED_PLAN_ID=
# Optional extra guard on the webhook endpoint beyond the SDK's own
# signature verification — lets the URL be rotated/revoked instantly if it
# ever leaks. Leave unset to skip this check.
FREEMIUS_WEBHOOK_TOKEN=

# --- Tech news feed (newsdata.io) ---
NEWS_API_KEY=

# --- Optional: bearer/query auth for /api/cron when triggered externally ---
CRON_SECRET=
